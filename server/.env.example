PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fathersadvice?retryWrites=true&w=majority
JWT_SECRET=your_strong_secret_here
JWT_EXPIRES_IN=7d
NODE_ENV=development
APP_URL=http://localhost:5000

# Google Sign-In (see /api/config — the frontend fetches GOOGLE_CLIENT_ID from
# there, it is never hardcoded client-side). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Admin account — this email bypasses password login and must sign in with
# Google (see routes/auth.js /login and /google). ADMIN_SECRET gates the
# admin-only routes in routes/admin.js.
ADMIN_EMAIL=admin@example.com
ADMIN_SECRET=your_admin_secret_here

# OTP verification email — sent via Gmail SMTP using an App Password, not your
# normal Gmail password. Requires 2-Step Verification enabled on the account:
# https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM=Father's Advice <your_gmail_address@gmail.com>

# Gemini-based doubt analysis / mentor matching
GEMINI_API_KEY=your_gemini_api_key_here

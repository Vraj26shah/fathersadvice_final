PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fathersadvice?retryWrites=true&w=majority
JWT_SECRET=your_strong_secret_here
JWT_EXPIRES_IN=7d
NODE_ENV=development
APP_URL=http://localhost:5000

# Google Sign-In (see /api/config — the frontend fetches GOOGLE_CLIENT_ID from
# there, it is never hardcoded client-side). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Admin account — this email bypasses password login and must sign in with
# Google (see routes/auth.js /login and /google). ADMIN_SECRET gates the
# admin-only routes in routes/admin.js.
ADMIN_EMAIL=admin@example.com
ADMIN_SECRET=your_admin_secret_here

# OTP verification email — always sent from the GMAIL_USER mailbox, so there is
# no sending domain to verify and any recipient can be emailed.
GMAIL_USER=your_gmail_address@gmail.com
EMAIL_FROM=Father's Advice <your_gmail_address@gmail.com>

# Transport 1 — Gmail API over HTTPS (port 443). Use this in production: hosts
# such as Render's free tier block outbound SMTP ports (25/465/587), so the
# App Password route below times out there while working fine locally.
# Enable the "Gmail API" in your Google Cloud project, add
# http://localhost:53682/oauth2callback as an authorised redirect URI on a
# "Web application" OAuth client, then run:
#     npm run gmail:token
# GMAIL_CLIENT_ID defaults to GOOGLE_CLIENT_ID above when left unset.
GMAIL_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# Transport 2 — Gmail SMTP with an App Password (not your normal password;
# needs 2-Step Verification: https://myaccount.google.com/apppasswords).
# Used automatically when the Gmail API vars above are absent, or if an API
# send fails. Convenient for local development.
GMAIL_APP_PASSWORD=your_16_char_app_password

# Gemini-based doubt analysis / mentor matching
GEMINI_API_KEY=your_gemini_api_key_here
